{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "tada": {
      "command": "${TADA_HOME}/app/node_modules/.bin/tsx",
      "args": [
        "--env-file-if-exists=${TADA_HOME}/app/.env.local",
        "${TADA_HOME}/app/mcp/server.ts",
        "--project", "dyno",
        "--owner-email", "you@example.com",
        "--url", "https://app.tada-ai.app",
        "--prod"
      ]
    }
  }
}
